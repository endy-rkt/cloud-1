#!/bin/sh

set -e

WP_TITLE="Penalty marchant"
WP_PATH="/var/www/html"
WP_URL="https://mobutu1337.duckdns.org"
WP_USER_PASSWORD=$(cat /run/secrets/wp_user_pass)
WP_ADMIN_PASSWORD=$(cat /run/secrets/wp_admin_pass)
WORDPRESS_DB_PASSWORD=$(cat $WORDPRESS_DB_PASSWORD_FILE)

if [ ! -e "$WP_PATH/wp-settings.php" ]; then
    echo "copying wordpress core files from image..."
    cp -R /usr/src/wordpress/. "$WP_PATH/"
fi

if [ ! -f "$WP_PATH/wp-config.php" ]; then
    echo "creating wp-config.php..."
    wp config create \
        --path="$WP_PATH" \
        --dbname="$WORDPRESS_DB_NAME" \
        --dbuser="$WORDPRESS_DB_USER" \
        --dbpass="$WORDPRESS_DB_PASSWORD" \
        --dbhost="$WORDPRESS_DB_HOST" \
        --allow-root
fi

if ! wp core is-installed --path="$WP_PATH" --allow-root; then
    echo "installing wordpress..."
    wp core install \
        --url="$WP_URL" \
        --title="$WP_TITLE" \
        --admin_user="$WP_ADMIN" \
        --admin_password="$WP_ADMIN_PASSWORD" \
        --admin_email="$WP_ADMIN_EMAIL" \
        --path="$WP_PATH" \
        --allow-root

    wp user create "$WP_USER" "$WP_USER_EMAIL" \
        --role=editor \
        --user_pass="$WP_USER_PASSWORD" \
        --path="$WP_PATH" \
        --allow-root
else
    echo "wordpress already installed, skipping"
fi

chmod -R 755 $WP_PATH

chown -R www-data:www-data $WP_PATH

exec docker-entrypoint.sh "$@"
